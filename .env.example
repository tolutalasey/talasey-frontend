# development | preview | staging | production. Anything but production is noindex.
APP_ENV=development
SITE_URL=http://localhost:3000

# The backend (talasey-backend). Products, baskets, orders, content and staff sign-in all come from it.
API_URL=http://localhost:4000

# Stripe publishable key (pk_...). When set, checkout shows Stripe's payment form; the backend needs
# STRIPE_SECRET_KEY from the same Stripe account. Empty means the labelled test payment.
STRIPE_PUBLISHABLE_KEY=

# Shared with the backend so it can ask the site to refresh pages after a change. At least 32 characters.
REVALIDATE_SECRET=

# Algolia search, read with a search-only key. Leave blank to search the published products in
# memory instead (local runs and tests).
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
ALGOLIA_PRODUCTS_INDEX=products

# Where contact form enquiries and their photos are saved locally (relative to this folder).
ENQUIRY_DIR=.data/enquiries
