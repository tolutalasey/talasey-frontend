{
  "name": "talasey-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "tokens": "tsx src/tokens/build.ts",
    "dev": "tsx src/tokens/build.ts && next dev --port 3000",
    "build": "tsx src/tokens/build.ts && next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsx src/tokens/build.ts && next typegen && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx src/tokens/build.ts && vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "lighthouse": "npx --yes @lhci/cli@0.16.1 autorun",
    "storybook": "tsx src/tokens/build.ts && storybook dev --port 6006",
    "storybook:build": "tsx src/tokens/build.ts && storybook build --quiet --output-dir storybook-static",
    "test:stories": "playwright test --config storybook/playwright.config.ts",
    "api:types": "openapi-typescript ../talasey-backend/openapi.json -o src/api-client/schema.d.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "storybook": "10.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
